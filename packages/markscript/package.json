{
  "name": "@markscript/markscript",
  "version": "0.1.0",
  "description": "Markdown-first document programming with TypeScript and MDAST",
  "keywords": [
    "markscript",
    "markdown",
    "mdast",
    "mdx",
    "typescript",
    "document-generation"
  ],
  "license": "MIT",
  "author": "Xiaodai Dai <diauweb@live.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/diauweb/markscript.git",
    "directory": "packages/markscript"
  },
  "homepage": "https://github.com/diauweb/markscript#readme",
  "bugs": {
    "url": "https://github.com/diauweb/markscript/issues"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "type": "module",
  "bin": {
    "markscript": "./dist/cli.js"
  },

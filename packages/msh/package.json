{
  "name": "msh",
  "version": "0.1.0",
  "private": true,
  "description": "Executable MarkScript threads and agent shell",
  "license": "MIT",
  "type": "module",
  "engines": {
    "bun": ">=1.4.0"
  },
  "bin": {
    "msh": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "bun": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./kernel": {
      "types": "./types/kernel.d.ts",
      "bun": "./dist/kernel.js",
      "default": "./dist/kernel.js"
    },
    "./examples/*": "./examples/*",
    "./prompts/*": "./prompts/*",
    "./library/*": "./library/*",
    "./core": {
      "types": "./types/core.d.ts",
      "bun": "./dist/core.js",
      "default": "./dist/core.js"
    },
    "./agent": {
      "types": "./types/agent.d.ts",
      "bun": "./dist/agent.js",
      "default": "./dist/agent.js"
    },
    "./approval": {
      "types": "./types/approval.d.ts",
      "bun": "./dist/approval.js",
      "default": "./dist/approval.js"
    },
    "./shell": {
      "types": "./types/shell.d.ts",
      "bun": "./dist/shell.js",
      "default": "./dist/shell.js"
    }
  },
  "files": [
    "dist",
    "types",
    "src",
    "prompts",
    "library",
    "examples",
    "web/dist"
  ],
  "scripts": {
    "start": "bun src/cli.ts",
    "test": "bun test test",
    "web:build": "vite build --config web/vite.config.ts",
    "web:typecheck": "tsc --noEmit -p web/tsconfig.json",
    "web:test": "bun test/web-smoke.ts && bun test/web-cli-smoke.ts"
  },
  "dependencies": {
    "@cloudflare/kumo": "^2.14.0",
    "@effect/ai-openai-compat": "4.0.0-rc.112",
    "@effect/platform-bun": "4.0.0-rc.112",
    "@markscript/compiler": "workspace:*",
    "@markscript/runtime": "workspace:*",
    "@phosphor-icons/react": "^2.1.10",
    "effect": "4.0.0-rc.112",
    "hast-util-sanitize": "^5.0.2",
    "hast-util-to-jsx-runtime": "^2.3.6",
    "langsmith": "0.10.2",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-gfm": "^3.1.0",
    "mdast-util-to-hast": "^13.2.1",
    "mdast-util-to-markdown": "^2.1.2",
    "proper-lockfile": "^4.1.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^6.0.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/hast": "^3.0.5",
    "@types/proper-lockfile": "^4.1.4",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "playwright": "^1.64.0",
    "tailwindcss": "^4.1.0",
    "vite": "^8.0.0"
  }
}
